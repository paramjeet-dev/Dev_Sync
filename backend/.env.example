# Server
PORT=5000
NODE_ENV=development

# Client
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dev-sync

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=dev_sync_token

# OpenAI Whisper (leave blank to disable voice transcription)
OPENAI_API_KEY=

# Audio upload limits
MAX_AUDIO_SIZE_MB=25
